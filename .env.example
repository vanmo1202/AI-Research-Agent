# Shared only by backend and worker. Use a randomly generated secret.
INTERNAL_API_KEY=replace-with-a-random-secret-at-least-32-characters

# Exact browser origin; HTTPS deployments require secure cookies.
FRONTEND_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
# Optional existing user UUID for trusted internal research creation only.
INTERNAL_RESEARCH_USER_ID=

# Dedicated nginx-to-backend network: keep these addresses inside the subnet.
BROWSER_PROXY_SUBNET=172.30.240.0/29
FRONTEND_PROXY_IP=172.30.240.2
BACKEND_PROXY_IP=172.30.240.3
