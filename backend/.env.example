PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
MOCK_LLM=true
TAVILY_API_KEY=your_tavily_api_key_here
SEARCH_PROVIDER=tavily
MOCK_SEARCH=true
SEARCH_CONCURRENCY=4
MAX_SOURCE_CONTENT_CHARS=20000
HTTP_TIMEOUT_MS=30000
HTTP_RETRY_COUNT=2
HTTP_RETRY_BASE_DELAY_MS=500
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_MAX_CHUNKS_PER_SOURCE=30
RAG_TOP_K=4
RAG_MIN_RELEVANCE_SCORE=0.25
REPORT_DEFAULT_LANGUAGE=vi
REPORT_MAX_CONTEXT_CHARS=50000
REPORT_INCLUDE_CITATIONS=true
MOCK_RAG=false
MOCK_REPORT=false

# Optional source translations; originals are always preserved.
TRANSLATE_SOURCE_CONTENT=true
TRANSLATE_MAX_CONTENT_CHARS=12000
TRANSLATE_SOURCE_CONCURRENCY=2
TRANSLATE_CHUNK_CONCURRENCY=1
TRANSLATE_CHUNK_CHARS=2200
GEMINI_TRANSLATION_TIMEOUT_MS=45000
GEMINI_TRANSLATION_RETRY_COUNT=3
GEMINI_TRANSLATION_RETRY_BASE_DELAY_MS=1000
CONTENT_FETCH_CONCURRENCY=5
GEMINI_MAX_CONCURRENT_REQUESTS=2
GEMINI_MIN_INTERVAL_MS=400
RAG_MAX_CONTEXT_CHARS=10000
RAG_ANALYSIS_CONCURRENCY=1
GEMINI_EVIDENCE_TIMEOUT_MS=60000
GEMINI_EVIDENCE_RETRY_COUNT=4
GEMINI_EVIDENCE_RETRY_BASE_DELAY_MS=1500

# Flow v2: backend and worker must share this key and RESEARCH_DB_PATH.
INTERNAL_API_KEY=replace-with-a-random-secret-at-least-32-characters
