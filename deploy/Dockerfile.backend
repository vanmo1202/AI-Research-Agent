# Reviewed amd64 pin used by the hardening smoke; revalidate before release.
ARG NODE_IMAGE=node@sha256:947e5454e08bfe0b8ddda604915ad76275276c774f47da90d0137252c793a778
FROM ${NODE_IMAGE}
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY . .
RUN mkdir -p /app/data /app/documents && chown -R node:node /app/data /app/documents && chmod 700 /app/data /app/documents
ENV NODE_ENV=production
USER node
EXPOSE 3000
CMD ["node", "src/server.js"]
