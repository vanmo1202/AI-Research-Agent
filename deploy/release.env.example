# Non-secret interpolation only. Copy OUTSIDE the repository; do not overwrite .env.
COMPOSE_PROJECT_NAME=researchos-staging
FRONTEND_ORIGIN=https://research.example.invalid
INTERNAL_RESEARCH_USER_ID=replace-with-existing-user-uuid
BACKEND_IMAGE=registry.example.invalid/researchos/backend@sha256:REPLACE
FRONTEND_IMAGE=registry.example.invalid/researchos/frontend@sha256:REPLACE
EDGE_IMAGE=nginx@sha256:REPLACE
N8N_IMAGE=n8nio/n8n:2.46.1@sha256:REPLACE
SECRETS_DIRECTORY=/srv/researchos-staging/secrets
TLS_DIRECTORY=/srv/researchos-staging/tls
HTTPS_BIND_IP=127.0.0.1
HTTPS_PORT=8443
MOCK_PROVIDERS=false
GEMINI_MODEL=gemini-2.5-flash

# Also provision SECRETS_DIRECTORY/postgres_password (0600). PostgreSQL has no published port.
POSTGRES_IMAGE=postgres:18-alpine@sha256:REPLACE
