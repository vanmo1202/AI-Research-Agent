{
  "name": "Knowledge · Document ingestion observer",
  "active": false,
  "nodes": [
    {
      "id": "c2fdaee1-8ad2-4dd4-9b79-71959384f320",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "knowledge/document-ingestion",
        "responseMode": "responseNode",
        "authentication": "headerAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_WEBHOOK_HEADER_CREDENTIAL",
          "name": "Research Webhook Access"
        }
      }
    },
    {
      "id": "8d39f762-3838-44b8-bead-3812a90dd67b",
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const b=$json.body||{};if(!/^[a-f0-9-]{36}$/.test(b.jobId||'')||!/^[a-f0-9-]{36}$/.test(b.documentId||''))throw new Error('documentId/jobId required');return [{json:{documentId:b.documentId,jobId:b.jobId}}];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "579723ff-1036-4fc2-95d2-6f1cee42e1fd",
      "name": "Backend state",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=http://backend:3000/internal/knowledge/jobs/{{ $json.jobId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "5851a1dc-d457-429a-8646-ce65a7553705",
      "name": "Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        660,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "906fb180-c4fc-41bf-80af-1702cb7b49f0",
      "name": "Error result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        660,
        200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {success:false,error:\"Knowledge automation failed; inspect backend status before retry\"} }}",
        "options": {
          "responseCode": 502
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Validate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate": {
      "main": [
        [
          {
            "node": "Backend state",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Error result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Backend state": {
      "main": [
        [
          {
            "node": "Result",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Error result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 60,
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none"
  }
}
