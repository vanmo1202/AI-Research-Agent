        "jsCode": "const b=$input.first().json.body ?? {};\nconst uuid=/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst key=/^[\\w.:/-]{1,160}$/;\nconst o=(b.options && typeof b.options==='object' && !Array.isArray(b.options))?b.options:{};\nconst options={language:o.language??'vi',numberOfSources:o.numberOfSources??12,searchMore:o.searchMore??true,orchestration:o.orchestration??'backend'};\nconst runId=b.runId??null;\nconst valid=(b.options===undefined || (b.options!==null && typeof b.options==='object' && !Array.isArray(b.options))) && typeof b.requestId==='string' && typeof b.idempotencyKey==='string' && uuid.test(b.requestId??'') && key.test(b.idempotencyKey??'') && (runId===null || (typeof runId==='string' && uuid.test(runId))) &&\n ['vi','en'].includes(options.language) && Number.isInteger(options.numberOfSources) && options.numberOfSources>=1 && options.numberOfSources<=30 &&\n typeof options.searchMore==='boolean' && ['backend','n8n'].includes(options.orchestration);\nreturn [{json:{valid,requestId:valid?b.requestId:null,runId:valid?runId:null,idempotencyKey:valid?b.idempotencyKey:null,options:valid?options:null,error:valid?null:'Invalid requestId / runId / idempotencyKey / options'}}];"
