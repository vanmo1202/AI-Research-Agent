    {
      "id": "41a13de5-f42d-56e8-9be4-ccf6ece974dd",
      "name": "02 - Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$input.first().json.body??{};\nconst uuid=/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst valid=uuid.test(b.documentId??'')&&uuid.test(b.jobId??'');\nreturn [{json:{valid,documentId:valid?b.documentId:null,jobId:valid?b.jobId:null,error:valid?null:'documentId/jobId UUID required'}}];"
      }
    },
    {
      "id": "440bc33a-ecf8-5ffe-8069-b6dd27cc9f71",
      "name": "03 - Valid Request?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        510,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "2e0c3829-4c00-568e-bb96-10cd7e90b393",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
