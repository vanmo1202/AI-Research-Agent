    {
      "id": "1099f369-46c6-56d3-a3d9-7b3558bd9870",
      "name": "08 - Document Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1250,
        -210
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx=$('02 - Validate Input').first().json;\nconst j=$input.first().json.data;\nif(!['pending','processing','ready','failed'].includes(j?.status))throw new Error('Invalid document job state');\nreturn [{json:{success:true,documentId:ctx.documentId,jobId:ctx.jobId,status:j.status,attempts:j.attempts??0,errorCode:j.error_code??null,updatedAt:j.updated_at??null,processingOwner:'backend-worker'}}];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "17cb3fdb-780b-5408-a95e-f625ec3924cc",
