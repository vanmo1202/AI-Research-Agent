        "mode": "runOnceForAllItems",
        "jsCode": "const v=$input.first().json; const n=Number(v.error?.httpCode??v.error?.statusCode??v.statusCode); const httpStatus=[400,401,403,404,409,429].includes(n)?n:502; return [{json:{success:false,httpStatus,error:\"Document job unavailable or access rejected\"}}];"
      }
    },
