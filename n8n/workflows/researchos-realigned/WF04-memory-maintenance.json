        -100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r=$input.first().json;if(r.success!==true||!Array.isArray(r.data))throw new Error('Invalid maintenance reply');return [{json:{success:true,operation:'memory-source-revalidation',summary:r.data,completedAt:new Date().toISOString()}}];"
      },
      "onError": "continueErrorOutput"
    },
